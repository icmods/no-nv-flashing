{
	"info": {
		"name": "No Night Vision Flashing",
		"author": "vsdum",
		"version": "1.0",
		"description": "A mod that removes the flashing effect when night vision effects have less than 10 seconds left"
	},
	"debugAbi": "arm64-v8a",
	"abis": [
		"armeabi-v7a",
		"arm64-v8a"
	],
	"linkNative": [
		"minecraftpe",
		"innercore",
		"nativejs"
	],
	"sources": [
		{
			"source": "dev",
			"target": "main.js",
			"type": "main",
			"language": "typescript"
		},
		{
			"source": "launcher.js",
			"type": "launcher",
			"language": "javascript"
		}
	],
	"compile": [
		{
			"source": "native/*",
			"type": "native"
		}
	],
	"additional": [
		"config.json",
		"config.info.json"
	]
}
