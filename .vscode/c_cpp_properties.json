{
    "configurations": [
        {
            "name": "ARM64",
            "compilerPath": "${env:NDK_PATH}/toolchains/llvm/prebuilt/windows-x86_64/bin/clang++.exe",
            "compilerArgs": [
                "--target=aarch64-linux-android24"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${env:APPDATA}/icmtoolchain/stdincludes/horizon"
            ],
            "cppStandard": "c++17",
            "cStandard": "c11",
            "intelliSenseMode": "linux-clang-arm64"
        },
        {
            "name": "ARM32",
            "compilerPath": "${env:NDK_PATH}/toolchains/llvm/prebuilt/windows-x86_64/bin/clang++.exe",
            "compilerArgs": [
                "--target=armv7a-linux-androideabi21"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${env:APPDATA}/icmtoolchain/stdincludes/horizon"
            ],
            "cppStandard": "c++17",
            "cStandard": "c11",
            "intelliSenseMode": "linux-clang-arm"
        }
    ],
    "version": 4
}
